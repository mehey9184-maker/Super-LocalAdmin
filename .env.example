# Super Admin uses the same Firebase client project as LocalEats.
# These are browser configuration values, not Firebase Admin/service-account credentials.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=localeats-5e26e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=localeats-5e26e
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id

# Base URL for the authoritative LocalEats API. Do not include /api/v1.
VITE_LOCALEATS_API_URL=https://replace-with-localeats-api.example
